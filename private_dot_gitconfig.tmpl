# ~/.gitconfig — managed by chezmoi (mode 0600 via the `private_` prefix).
# Identity comes from chezmoi data (prompted on init), not from a committed value.
[user]
    name = {{ .name | quote }}
    email = {{ .email | quote }}

# Use the GitHub CLI as the credential helper (works for HTTPS remotes).
[credential "https://github.com"]
    helper =
    helper = !gh auth git-credential
[credential "https://gist.github.com"]
    helper =
    helper = !gh auth git-credential

[init]
    defaultBranch = main
[pull]
    rebase = false

# Identity per folder: everything under the workspace is personal, except the
# work folder. Later includes win, so the work one goes last.
[includeIf "gitdir:{{ .workspace }}/"]
    path = ~/.gitconfig.personal
{{- if .work }}
[includeIf "gitdir:{{ .workspace }}/{{ .work_dir }}/"]
    path = ~/.gitconfig.work
{{- end }}

# Machine-local overrides (signing keys, work-only settings) — NEVER committed.
[include]
    path = ~/.gitconfig.local
