# base — the tool's own dependencies + everyday CLI. Always installed.
brew "chezmoi"    # dotfiles + secrets engine
brew "gum"        # TUI widgets for the installer
brew "gitleaks"   # secret scanning
brew "age"        # file encryption for committable secrets
brew "gh"         # GitHub CLI (also the git credential helper)
brew "mise"       # runtime version manager
brew "jq"         # JSON on the command line
brew "coreutils"  # GNU core utils
brew "shellcheck" # shell linting (used by `make lint`)
